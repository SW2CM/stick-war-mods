<?xml version="1.0" encoding="utf-8"?>
<project>
    <meta title="SW2CM Mod Browser" package="sw2cm.modbrowser" version="1.0.0" company="SW2CM" />
    <app main="sw2cm.browser.Main" file="sw2cmbrowser" path="build/openfl" />
	<icon path="assets/icons/sw2cm.png" />

    <window background="#3D4F41" fps="60" />
    <window width="1500" height="1000" if="desktop" />
    <window width="0" height="0" if="html5" />
	<window allow-high-dpi="true" />

    <!-- classpath, haxe libs -->
    <source path="src" />

    <haxelib name="openfl" />
    <haxelib name="actuate" />

    <haxelib name="haxeui-core" />
    <haxelib name="haxeui-openfl" />
</project>
